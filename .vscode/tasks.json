{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build project",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++11",
                "-Wall",
                "src/*.cpp",
                "-o",
                "project"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles every .cpp file in src/ into ./project"
        },
        {
            "label": "Run project",
            "type": "shell",
            "command": "./project",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build project",
            "problemMatcher": []
        }
    ]
}
